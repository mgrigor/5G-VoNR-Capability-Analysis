      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1fppc0e1vkccnp158k12g1bzhq7d].[min:Calculation_0754874440183809:qk]&quot;' value='VoNR Setups (7d)' />
          <alias key='&quot;[federated.1fppc0e1vkccnp158k12g1bzhq7d].[min:Calculation_0754874440617986:qk]&quot;' value='Media Evidence (7d)*' />
        </aliases>
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_0754874438230016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([date]) }' />
      </column>
      <column caption='Setups 7d' datatype='integer' name='[Calculation_0754874440183809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [gnb_id] : SUM( IF [date] &gt; [Calculation_0754874438230016] - 7 THEN [vonr_setup_att] END ) }' />
      </column>
      <column caption='Media 7d' datatype='real' name='[Calculation_0754874440617986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [gnb_id] : SUM( IF [date] &gt; [Calculation_0754874438230016] - 7 THEN [vonr_media_evidence] END)}' />
      </column>
      <column caption='VoNR Status' datatype='string' name='[Calculation_0754874440966147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0754874440183809] &gt; 0 THEN &quot;Active VoNR&quot;&#13;&#10;   ELSEIF [Calculation_0754874440617986] &gt; 0 THEN &quot;VoNR via Handover Only&quot;&#13;&#10;   ELSE &quot;EPS Fallback&quot;&#13;&#10;   END' />
      </column>
      <column caption='Total gNBs' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0754874443501573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([gnb_id])' />
      </column>
      <column caption='Active VoNR' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0754874443898886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_0754874440966147] = &quot;Active VoNR&quot; THEN [gnb_id] END )' />
      </column>
      <column caption='Handover Only' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0754874444054535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_0754874440966147] = &quot;VoNR via Handover Only&quot; THEN [gnb_id] END )' />
      </column>
      <column caption='EPS Fallback' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0754874444214280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_0754874440966147] = &quot;EPS Fallback&quot; THEN [gnb_id] END )' />
      </column>
      <column caption='VoNR Coverage' datatype='real' default-format='p0.0%' name='[Calculation_0754874444328969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0754874443898886] / [Calculation_0754874443501573]' />
      </column>
      <column caption='VoNR Traffic %' datatype='real' name='[Calculation_0754874669137930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [vonr_setup_att] &gt; 0 OR [vonr_media_evidence] &gt; 0 THEN [gnb_id] END )&#13;&#10;/ COUNTD([gnb_id])' />
      </column>
      <column caption='Min Date' datatype='date' name='[Calculation_0754874701410315]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MIN([date]) }' />
      </column>
      <column caption='Coverage Start' datatype='real' default-format='p0.0%' name='[Calculation_0754874701525004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [date] = [Calculation_0754874701410315] AND ([vonr_setup_att] &gt; 0 OR [vonr_media_evidence] &gt; 0) THEN [gnb_id] END )&#13;&#10;/ COUNTD( IF [date] = [Calculation_0754874701410315] THEN [gnb_id] END )' />
      </column>
      <column caption='Coverage End' datatype='real' default-format='p0.0%' name='[Calculation_0754874701864973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [date] = [Calculation_0754874438230016] AND ([vonr_setup_att] &gt; 0 OR [vonr_media_evidence] &gt; 0) THEN [gnb_id] END )&#13;&#10;/ COUNTD( IF [date] = [Calculation_0754874438230016] THEN [gnb_id] END )' />
      </column>
